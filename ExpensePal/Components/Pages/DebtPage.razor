@page "/debt"
@using System.Text.Json;
@inject IJSRuntime JS

<div class="d-flex justify-content-between mb-3 mt-20">
    <div class="d-flex">
        <div class="me-3">
            <label for="filterTitle">Title:</label>
            <input type="text" id="filterTitle" class="form-control" @bind="filterTitle" placeholder="Search by title" />
        </div>
        <div class="me-3">
            <label for="filterStatus">Status:</label>
            <select id="filterStatus" class="form-control" @bind="filterStatus">
                <option value="">Select an option</option>
                <option value="Pending">Pending</option>
                <option value="Paid">Paid</option>
            </select>
        </div>
        <div class="me-3">
            <label for="sortOrder">Sort By Due Date:</label>
            <select id="sortOrder" class="form-control" @bind="sortOrder">
                <option value="Ascending">Ascending</option>
                <option value="Descending">Descending</option>
            </select>
        </div>
    </div>
    <div class="align-self-end">
        <button class="btn btn-secondary" @onclick="FilterDebts">Filter</button>
        <button class="btn btn-outline-secondary" @onclick="ClearFilters">Clear</button>
        <button class="btn btn-primary ms-3" @onclick="OpenModal">Add Debt</button>
    </div>
</div>

<!-- Display the totals (Debt, Available Balance) -->
<div class="mt-3">
    <h5>Total Debt: @TotalDebt</h5>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Date</th>
            <th>Title</th>
            <th>Status</th>
            <th>Amount</th>
            <th>Due Date</th>
            <th>Notes</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var debt in filteredDebts)
    {
        <tr>
            <td>@debt.DueDate.ToShortDateString()</td>
            <td>@debt.Title</td>
            <td>@debt.Status</td>
            <td>@debt.Amount</td>
            <td>@debt.DueDate.ToShortDateString()</td>
            <td>@debt.Notes</td>
            <td>
                @if (debt.Status != "Paid")
                {
                    <button class="btn btn-success" @onclick="() => MarkAsPaid(debt)">Mark as Paid</button>
                }
            </td>
        </tr>
    }
</tbody>
</table>


<EditForm Model="newDebt" OnValidSubmit="AddDebt">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="modal" style="display:@(isModalOpen ? "block" : "none")">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Debt</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label>Title</label>
                        <input type="text" class="form-control" @bind="newDebt.Title" placeholder="Enter title" />
                        <ValidationMessage For="@(() => newDebt.Title)" />
                    </div>
                    <div class="mb-3">
                        <label for="status">Status</label>
                        <select id="status" class="form-control" @bind="newDebt.Status">
                            <option value="">Select an option</option>
                            <option value="Pending">Pending</option>
                            <option value="Paid">Paid</option>
                        </select>
                        <ValidationMessage For="@(() => newDebt.Status)" />
                    </div>

                    <div class="mb-3">
                        <label>Amount</label>
                        <input type="number" class="form-control" @bind="newDebt.Amount" placeholder="Enter amount" />
                        <ValidationMessage For="@(() => newDebt.Amount)" />
                    </div>
                    <div class="mb-3">
                        <label>Due Date</label>
                        <input type="date" class="form-control" @bind="newDebt.DueDate" />
                        <ValidationMessage For="@(() => newDebt.DueDate)" />
                    </div>
                    <div class="mb-3">
                        <label>Notes</label>
                        <input type="text" class="form-control" @bind="newDebt.Notes" placeholder="Enter notes" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </div>
        </div>
    </div>
</EditForm>