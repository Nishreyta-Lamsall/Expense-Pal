@page "/debt"
@using System.Text.Json;
@inject IJSRuntime JS

<div class="d-flex justify-content-between mb-3 mt-20">
    <div class="d-flex">
        <div class="me-3">
            <label for="filterTitle">Title:</label>
            <input type="text" id="filterTitle" class="form-control" @bind="filterTitle" placeholder="Search by title" />
        </div>
        <div class="me-3">
            <label for="filterStatus">Status:</label>
            <select id="filterStatus" class="form-control" @bind="filterStatus">
                <option value="">Select an option</option>
                <option value="Pending">Pending</option>
                <option value="Overdue">Overdue</option>
                <option value="Paid">Paid</option>
            </select>
        </div>
        <div class="me-3">
            <label for="sortOrder">Sort By Due Date:</label>
            <select id="sortOrder" class="form-control" @bind="sortOrder">
                <option value="Ascending">Ascending</option>
                <option value="Descending">Descending</option>
            </select>
        </div>
    </div>
    <div class="align-self-end">
        <button class="btn btn-secondary" @onclick="FilterDebts">Filter</button>
        <button class="btn btn-outline-secondary" @onclick="ClearFilters">Clear</button>
        <button class="btn btn-primary ms-3" @onclick="OpenModal">Add Debt</button>
    </div>
</div>

<!-- Display the totals (Debt, Available Balance) -->
<div class="mt-3">
    <h5>Total Debt: @TotalDebt</h5>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Date</th>
            <th>Title</th>
            <th>Status</th>
            <th>Amount</th>
            <th>Due Date</th>
            <th>Notes</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var debt in filteredDebts)
        {
            <tr>
                <td>@debt.DueDate.ToShortDateString()</td>
                <td>@debt.Title</td>
                <td>@debt.Status</td>
                <td>@debt.Amount</td>
                <td>@debt.DueDate.ToShortDateString()</td>
                <td>@debt.Notes</td>
            </tr>
        }
    </tbody>
</table>

<EditForm Model="newDebt">
    <div class="modal" style="display:@(isModalOpen ? "block" : "none")">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Debt</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label>Title</label>
                        <input type="text" class="form-control" @bind="newDebt.Title" placeholder="Enter title" />
                    </div>
                    <div class="mb-3">
                        <label for="status">Status</label>
                        <select id="status" class="form-control" @bind="newDebt.Status">
                            <option value="">Select an option</option>
                            <option value="Pending">Pending</option>
                            <option value="Overdue">Overdue</option>
                            <option value="Paid">Paid</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label>Amount</label>
                        <input type="number" class="form-control" @bind="newDebt.Amount" placeholder="Enter amount" />
                    </div>
                    <div class="mb-3">
                        <label>Due Date</label>
                        <input type="date" class="form-control" @bind="newDebt.DueDate" />
                    </div>
                    <div class="mb-3">
                        <label>Notes</label>
                        <input type="text" class="form-control" @bind="newDebt.Notes" placeholder="Enter notes" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="AddDebt">Save</button>
                </div>
            </div>
        </div>
    </div>
</EditForm>

@code {
    private static readonly string DebtFilePath = Path.Combine(FileSystem.AppDataDirectory, "debt.json");

    private List<Debt> debtList = new();
    private List<Debt> filteredDebts = new();
    private Debt newDebt = new();
    private string filterTitle;
    private string filterStatus;
    private string sortOrder = "Ascending";
    private bool isModalOpen = false;

    private decimal totalDebt;

    public decimal TotalDebt => totalDebt;

    protected override void OnInitialized()
    {
        // Load debts from the JSON file
        LoadDebts();
        filteredDebts = debtList;
        CalculateTotals();
    }

    private void LoadDebts()
    {
        if (File.Exists(DebtFilePath))
        {
            var json = File.ReadAllText(DebtFilePath);

            if (string.IsNullOrWhiteSpace(json))
            {
                debtList = new List<Debt>(); // Initialize as empty if the file is empty
            }
            else
            {
                try
                {
                    debtList = JsonSerializer.Deserialize<List<Debt>>(json);
                    if (debtList == null) debtList = new List<Debt>();
                }
                catch (JsonException)
                {
                    debtList = new List<Debt>();
                }
            }
        }
    }

    private void FilterDebts()
    {
        filteredDebts = debtList.Where(d =>
            (string.IsNullOrWhiteSpace(filterTitle) ||
             (d.Title != null && d.Title.Contains(filterTitle, StringComparison.OrdinalIgnoreCase))) &&  // Null check for Title
            (string.IsNullOrWhiteSpace(filterStatus) ||
             (d.Status != null && d.Status.Contains(filterStatus, StringComparison.OrdinalIgnoreCase)))  // Null check for Status
        ).ToList();

        // Sort debts based on selected sort order
        if (sortOrder == "Ascending")
        {
            filteredDebts = filteredDebts.OrderBy(d => d.DueDate).ToList();
        }
        else if (sortOrder == "Descending")
        {
            filteredDebts = filteredDebts.OrderByDescending(d => d.DueDate).ToList();
        }

        CalculateTotals();
    }

    private void ClearFilters()
    {
        filterTitle = null;
        filterStatus = null;
        sortOrder = "Ascending";
        filteredDebts = debtList;
        CalculateTotals();
    }

    private async Task AddDebt()
    {
        // Add the new debt to the list
        debtList.Add(newDebt);
        newDebt = new Debt();
        FilterDebts();
        SaveDebts();
        CloseModal();
    }

    private void OpenModal() => isModalOpen = true;
    private void CloseModal() => isModalOpen = false;

    private void SaveDebts()
    {
        var json = JsonSerializer.Serialize(debtList);
        File.WriteAllText(DebtFilePath, json);
    }

    private void CalculateTotals()
    {
        totalDebt = debtList.Sum(d => d.Amount);
    }

    public class Debt
    {
        public string Title { get; set; }
        public string Status { get; set; }
        public DateTime DueDate { get; set; } = DateTime.MinValue;
        public decimal Amount { get; set; }
        public string Notes { get; set; }
        public string Source { get; set; }
        public string Tags { get; set; }
    }
}
