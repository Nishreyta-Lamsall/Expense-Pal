@page "/dashboard"
@using System.IO
@using System.Text.Json
@inject IJSRuntime JSRuntime

<h3 class="balance-text">Available Balance = @AvailableBalance</h3>

<div class="row">
    <div class="col-md-4">
        <div class="dashboard-card card-inflow text-center">
            <h5>Total Inflows</h5>
            <h2>@TotalIncome</h2>
        </div>
    </div>
    <div class="col-md-4">
        <div class="dashboard-card card-outflow text-center">
            <h5>Total Outflows</h5>
            <h2>@TotalExpense</h2>
        </div>
    </div>
    <div class="col-md-4">
        <div class="dashboard-card card-debt text-center">
            <h5>Total Debt</h5>
            <h2>@TotalDebt</h2>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-12">
        <div class="dashboard-section">
            <div class="dashboard-header">
                <h5>Transactions</h5>
                <div>
                    <button class="btn btn-primary" @onclick="ShowHighest">Show Top 5 Highest</button>
                    <button class="btn btn-secondary" @onclick="ShowLowest">Show Top 5 Lowest</button>
                </div>
                <div>
                    <!-- Date Range Filter for Transactions -->
                    <label>Start Date: </label>
                    <input type="date" @bind="StartDateTransaction" />
                    <label>End Date: </label>
                    <input type="date" @bind="EndDateTransaction" />
                    <button class="btn btn-info" @onclick="FilterTransactionsByDate">Filter</button>
                </div>
            </div>
            <div class="transaction-list mt-4">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Date</th>
                            <th>Amount</th>
                            <th>Type</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var transaction in FilteredTransactions)
                        {
                            <tr>
                                <td>@transaction.Title</td>
                                <td>@transaction.Date.ToString("yyyy-MM-dd")</td>
                                <td>@transaction.Amount.ToString("C")</td>
                                <td class="@(transaction.Type == "Income" ? "income" : transaction.Type == "Expense" ? "expense" : "debt")">
                                    @transaction.Type
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-12">
        <div class="dashboard-section">
            <div class="dashboard-header">
                <h5>Debts</h5>
                <div>
                    <button class="btn btn-primary" @onclick="ShowOverdue">Show Overdue Debts First</button>
                    <button class="btn btn-secondary" @onclick="ShowAllDebts">Show All Debts</button>
                </div>
                <div>
                    <!-- Date Range Filter for Debts -->
                    <label>Start Date: </label>
                    <input type="date" @bind="StartDateDebt" />
                    <label>End Date: </label>
                    <input type="date" @bind="EndDateDebt" />
                    <button class="btn btn-info" @onclick="FilterDebtsByDate">Filter</button>
                </div>
            </div>
            <div class="debt-list mt-4">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Source</th>
                            <th>Due Date</th>
                            <th>Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var debt in FilteredDebts)
                        {
                            <tr>
                                <td>@debt.Source</td>
                                <td>@debt.DueDate.ToString("yyyy-MM-dd")</td>
                                <td>@debt.Amount.ToString("C")</td>
                                <td class="@(debt.Status == "Overdue" ? "overdue" : "paid")">
                                    @debt.Status
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Transaction> Transactions = new List<Transaction>();
    private List<Debt> Debts = new List<Debt>();
    private List<Transaction> FilteredTransactions = new List<Transaction>();
    private List<Debt> FilteredDebts = new List<Debt>();

    private decimal totalIncome;
    private decimal totalExpense;
    private decimal totalDebt;

    public decimal TotalIncome => totalIncome;
    public decimal TotalExpense => totalExpense;
    public decimal TotalDebt => totalDebt;

    // Property for available balance
    public decimal AvailableBalance => TotalIncome + TotalDebt - TotalExpense;

    // Define the path to the JSON files
    private static readonly string TransactionFilePath = Path.Combine(FileSystem.AppDataDirectory, "transaction.json");
    private static readonly string DebtFilePath = Path.Combine(FileSystem.AppDataDirectory, "debt.json");

    // Date Range for Transactions
    private DateTime? StartDateTransaction { get; set; }
    private DateTime? EndDateTransaction { get; set; }

    // Date Range for Debts
    private DateTime? StartDateDebt { get; set; }
    private DateTime? EndDateDebt { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Load transactions and debts on initialization
        await LoadTransactionsAndDebts();
        CalculateTotals();
        ShowAllDebts();
        ShowHighest(); 
        StateHasChanged();
    }

    private async Task LoadTransactionsAndDebts()
    {
        // Load transactions from the transaction.json file
        if (File.Exists(TransactionFilePath))
        {
            var json = await File.ReadAllTextAsync(TransactionFilePath);
            Transactions = JsonSerializer.Deserialize<List<Transaction>>(json) ?? new List<Transaction>();
        }

        // Load debts from the debt.json file
        if (File.Exists(DebtFilePath))
        {
            var json = await File.ReadAllTextAsync(DebtFilePath);
            Debts = JsonSerializer.Deserialize<List<Debt>>(json) ?? new List<Debt>();
        }
    }

    private void CalculateTotals()
    {
        totalIncome = Transactions.Where(t => t.Type == "Income").Sum(t => t.Amount);
        totalExpense = Transactions.Where(t => t.Type == "Expense").Sum(t => t.Amount);
        totalDebt = Debts.Sum(d => d.Amount); // Calculating debts from the debt file
    }

    private void ShowHighest()
    {
        FilteredTransactions = Transactions
            .OrderByDescending(t => t.Amount)
            .Take(5)
            .ToList();
        StateHasChanged();  // Refresh the UI
    }

    private void ShowLowest()
    {
        FilteredTransactions = Transactions
            .OrderBy(t => t.Amount)
            .Take(5)
            .ToList();
        StateHasChanged(); 
    }

    private void ShowOverdue()
    {
        FilteredDebts = Debts
            .Where(d => d.Status == "Overdue")
            .Concat(Debts.Where(d => d.Status != "Overdue"))
            .ToList();
        StateHasChanged();  
    }

    private void ShowAllDebts()
    {
        FilteredDebts = Debts;
        StateHasChanged(); 
    }

    private void FilterTransactionsByDate()
    {
        FilteredTransactions = Transactions
            .Where(t => (!StartDateTransaction.HasValue || t.Date >= StartDateTransaction.Value) &&
                        (!EndDateTransaction.HasValue || t.Date <= EndDateTransaction.Value))
            .ToList();
        StateHasChanged(); 
    }

    private void FilterDebtsByDate()
    {
        FilteredDebts = Debts
            .Where(d => (!StartDateDebt.HasValue || d.DueDate >= StartDateDebt.Value) &&
                        (!EndDateDebt.HasValue || d.DueDate <= EndDateDebt.Value))
            .ToList();
        StateHasChanged();  
    }

    private async Task AddTransaction(Transaction newTransaction)
    {
        Transactions.Add(newTransaction);
        await SaveTransactions();
        CalculateTotals();
        StateHasChanged();  
    }

    private async Task AddDebt(Debt newDebt)
    {
        Debts.Add(newDebt);
        await SaveDebts();
        CalculateTotals();
        StateHasChanged();  
    }

    private async Task SaveTransactions()
    {
        var json = JsonSerializer.Serialize(Transactions);
        await File.WriteAllTextAsync(TransactionFilePath, json);
    }


    private async Task SaveDebts()
    {
        var json = JsonSerializer.Serialize(Debts);
        await File.WriteAllTextAsync(DebtFilePath, json);
    }

    public class Transaction
    {
        public string Title { get; set; }  
        public decimal Amount { get; set; }
        public string Type { get; set; } 
        public DateTime Date { get; set; }
    }

    public class Debt
    {
        public string Title { get; set; }  
        public decimal Amount { get; set; }
        public DateTime DueDate { get; set; }  
        public string Status { get; set; }  
        public string Notes { get; set; }
        public string Source { get; set; }
        public string Tags { get; set; }
    }
}
