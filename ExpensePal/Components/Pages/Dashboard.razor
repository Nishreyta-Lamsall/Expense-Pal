@page "/dashboard"
@using System.IO
@using System.Text.Json
@inject IJSRuntime JSRuntime

<h3 class="balance-text">Available Balance = @AvailableBalance</h3>

<div class="row">
    <div class="col-md-4">
        <div class="dashboard-card card-inflow text-center">
            <h5>Total Inflows</h5>
            <h2>@TotalIncome</h2>
        </div>
    </div>
    <div class="col-md-4">
        <div class="dashboard-card card-outflow text-center">
            <h5>Total Outflows</h5>
            <h2>@TotalExpense</h2>
        </div>
    </div>
    <div class="col-md-4">
        <div class="dashboard-card card-debt text-center">
            <h5>Total Debt</h5>
            <h2>@TotalDebt</h2>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-12">
        <div class="dashboard-section">
            <div class="dashboard-header">
                <h5>Transactions</h5>
                <div>
                    <button class="btn btn-primary" @onclick="ShowHighestTransactions">Show Top 5 Highest</button>
                    <button class="btn btn-secondary" @onclick="ShowLowestTransactions">Show Top 5 Lowest</button>
                </div>
                <div>
                    <label>Start Date: </label>
                    <input type="date" @bind="StartDateTransaction" />
                    <label>End Date: </label>
                    <input type="date" @bind="EndDateTransaction" />
                    <button class="btn btn-info" @onclick="FilterTransactionsByDate">Filter</button>
                </div>
            </div>
            <div class="transaction-list mt-4">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Date</th>
                            <th>Amount</th>
                            <th>Type</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var transaction in FilteredTransactions)
                        {
                            <tr>
                                <td>@transaction.Title</td>
                                <td>@transaction.Date.ToString("yyyy-MM-dd")</td>
                                <td>@transaction.Amount.ToString("C")</td>
                                <td class="@(transaction.Type == "Income" ? "income" : transaction.Type == "Expense" ? "expense" : "debt")">
                                    @transaction.Type
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-12">
        <div class="dashboard-section">
            <div class="dashboard-header">
                <h5>Debts</h5>
                <div class="d-flex flex-wrap gap-2 mt-2">
                    <button class="btn btn-primary flex-grow-1" @onclick="ShowHighestDebts">Top 5 Highest</button>
                    <button class="btn btn-secondary flex-grow-1" @onclick="ShowLowestDebts">Top 5 Lowest</button>
                    <button class="btn btn-secondary flex-grow-1" @onclick="ShowOverdue">Overdue Debts</button>
                    <button class="btn btn-secondary flex-grow-1" @onclick="ShowAllDebts">All Debts</button>
                </div>
                <div class="mt-3">
                    <label class="me-2">Start Date:</label>
                    <input type="date" class="form-control d-inline-block w-auto" @bind="StartDateDebt" />
                    <label class="ms-3 me-2">End Date:</label>
                    <input type="date" class="form-control d-inline-block w-auto" @bind="EndDateDebt" />
                    <button class="btn btn-info ms-3" @onclick="FilterDebtsByDate">Filter</button>
                </div>
            </div>
            <div class="debt-list mt-4">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Source</th>
                            <th>Due Date</th>
                            <th>Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var debt in FilteredDebts)
                        {
                            <tr>
                                <td>@debt.Source</td>
                                <td>@debt.DueDate.ToString("yyyy-MM-dd")</td>
                                <td>@debt.Amount.ToString("C")</td>
                                <td class="@(debt.Status == "Overdue" ? "overdue" : "paid")">
                                    @debt.Status
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Transaction> Transactions = new List<Transaction>();
    private List<Debt> Debts = new List<Debt>();
    private List<Transaction> FilteredTransactions = new List<Transaction>();
    private List<Debt> FilteredDebts = new List<Debt>();

    private decimal totalIncome;
    private decimal totalExpense;
    private decimal totalDebt;

    public decimal TotalIncome => totalIncome;
    public decimal TotalExpense => totalExpense;
    public decimal TotalDebt => totalDebt;

    public decimal AvailableBalance => TotalIncome + TotalDebt - TotalExpense;

    private static readonly string TransactionFilePath = Path.Combine(FileSystem.AppDataDirectory, "transaction.json");
    private static readonly string DebtFilePath = Path.Combine(FileSystem.AppDataDirectory, "debt.json");

    private DateTime? StartDateTransaction { get; set; }
    private DateTime? EndDateTransaction { get; set; }

    private DateTime? StartDateDebt { get; set; }
    private DateTime? EndDateDebt { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadTransactionsAndDebts();
        CalculateTotals();
        ShowAllDebts();
        ShowHighestTransactions();
    }

    private async Task LoadTransactionsAndDebts()
    {
        if (File.Exists(TransactionFilePath))
        {
            var json = await File.ReadAllTextAsync(TransactionFilePath);
            Transactions = JsonSerializer.Deserialize<List<Transaction>>(json) ?? new List<Transaction>();
        }

        if (File.Exists(DebtFilePath))
        {
            var json = await File.ReadAllTextAsync(DebtFilePath);
            Debts = JsonSerializer.Deserialize<List<Debt>>(json) ?? new List<Debt>();
        }
    }

    private void CalculateTotals()
    {
        totalIncome = Transactions.Where(t => t.Type == "Income").Sum(t => t.Amount);
        totalExpense = Transactions.Where(t => t.Type == "Expense").Sum(t => t.Amount);
        totalDebt = Debts.Sum(d => d.Amount);
    }

    private void ShowHighestTransactions()
    {
        FilteredTransactions = Transactions.OrderByDescending(t => t.Amount).Take(5).ToList();
    }

    private void ShowLowestTransactions()
    {
        FilteredTransactions = Transactions.OrderBy(t => t.Amount).Take(5).ToList();
    }

    private void ShowHighestDebts()
    {
        FilteredDebts = Debts.OrderByDescending(d => d.Amount).Take(5).ToList();
    }

    private void ShowLowestDebts()
    {
        FilteredDebts = Debts.OrderBy(d => d.Amount).Take(5).ToList();
    }

    private void ShowOverdue()
    {
        FilteredDebts = Debts.Where(d => d.Status == "Overdue").Concat(Debts.Where(d => d.Status != "Overdue")).ToList();
    }

    private void ShowAllDebts()
    {
        FilteredDebts = Debts;
    }

    private void FilterTransactionsByDate()
    {
        FilteredTransactions = Transactions
            .Where(t => (!StartDateTransaction.HasValue || t.Date >= StartDateTransaction.Value) &&
                        (!EndDateTransaction.HasValue || t.Date <= EndDateTransaction.Value))
            .ToList();
    }

    private void FilterDebtsByDate()
    {
        FilteredDebts = Debts
            .Where(d => (!StartDateDebt.HasValue || d.DueDate >= StartDateDebt.Value) &&
                        (!EndDateDebt.HasValue || d.DueDate <= EndDateDebt.Value))
            .ToList();
    }

    public class Transaction
    {
        public string Title { get; set; }
        public decimal Amount { get; set; }
        public string Type { get; set; }
        public DateTime Date { get; set; }
    }

    public class Debt
    {
        public string Source { get; set; }
        public decimal Amount { get; set; }
        public DateTime DueDate { get; set; }
        public string Status { get; set; }
    }
}
