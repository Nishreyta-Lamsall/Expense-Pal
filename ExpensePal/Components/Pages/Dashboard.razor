@page "/dashboard"
@using System.IO
@using System.Text.Json
@inject IJSRuntime JSRuntime

<h3 class="balance-text">Available Balance = @AvailableBalance</h3>

<div class="row">
    <div class="col-md-4">
        <div class="dashboard-card card-inflow text-center">
            <h5>Total Inflows</h5>
            <h2>@TotalIncome</h2>
        </div>
    </div>
    <div class="col-md-4">
        <div class="dashboard-card card-outflow text-center">
            <h5>Total Outflows</h5>
            <h2>@TotalExpense</h2>
        </div>
    </div>
    <div class="col-md-4">
        <div class="dashboard-card card-debt text-center">
            <h5>Remaining Debt</h5>
            <h2>@TotalDebt</h2>
        </div>
    </div>
    <div class="col-md-4" style="margin-top: 20px;">
        <div class="dashboard-card card-debt text-center">
            <h5>Cleared Debt</h5>
            <h2>@PaidDebt</h2>
        </div>
    </div>
    <div class="col-md-4" style="margin-top: 20px;">
        <div class="dashboard-card card-debt text-center">
            <h5>Debt</h5>
            <h2>@(TotalDebt + PaidDebt)</h2>
        </div>
    </div>

</div>

<div>
    <canvas id="pieChart" class="pie-chart"></canvas>
</div>

<div class="row mt-4">
    <div class="col-md-12">
        <div class="dashboard-section">
            <div class="dashboard-header">
                <h5>Transactions</h5>
                <div>
                    <button class="btn btn-primary" @onclick="ShowHighestTransactions">Show Top 5 Highest</button>
                    <button class="btn btn-secondary" @onclick="ShowLowestTransactions">Show Top 5 Lowest</button>
                </div>
                <div>
                    <label>Start Date: </label>
                    <input type="date" @bind="StartDateTransaction" />
                    <label>End Date: </label>
                    <input type="date" @bind="EndDateTransaction" />
                    <button class="btn btn-info" @onclick="FilterTransactionsByDate">Filter</button>
                </div>
            </div>
            <div class="transaction-list mt-4">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Date</th>
                            <th>Amount</th>
                            <th>Type</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var transaction in FilteredTransactions)
                        {
                            <tr>
                                <td>@transaction.Title</td>
                                <td>@transaction.Date.ToString("yyyy-MM-dd")</td>
                                <td>@transaction.Amount.ToString("C")</td>
                                <td class="@(transaction.Type == "Income" ? "income" : transaction.Type == "Expense" ? "expense" : "debt")">
                                    @transaction.Type
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-12">
        <div class="dashboard-section">
            <div class="dashboard-header">
                <h5>Debts</h5>
                <div class="d-flex flex-wrap gap-2 mt-2">
                    <button class="btn btn-primary flex-grow-1" @onclick="ShowHighestDebts">Top 5 Highest</button>
                    <button class="btn btn-secondary flex-grow-1" @onclick="ShowLowestDebts">Top 5 Lowest</button>
                    <button class="btn btn-secondary flex-grow-1" @onclick="ShowOverdue">Pending Debts</button>
                    <button class="btn btn-secondary flex-grow-1" @onclick="ShowAllDebts">All Debts</button>
                </div>
                <div class="mt-3">
                    <label class="me-2">Start Date:</label>
                    <input type="date" class="form-control d-inline-block w-auto" @bind="StartDateDebt" />
                    <label class="ms-3 me-2">End Date:</label>
                    <input type="date" class="form-control d-inline-block w-auto" @bind="EndDateDebt" />
                    <button class="btn btn-info ms-3" @onclick="FilterDebtsByDate">Filter</button>
                </div>
            </div>
            <div class="debt-list mt-4">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Source</th>
                            <th>Due Date</th>
                            <th>Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var debt in FilteredDebts)
                        {
                            <tr>
                                <td>@debt.Source</td>
                                <td>@debt.DueDate.ToString("yyyy-MM-dd")</td>
                                <td>@debt.Amount.ToString("C")</td>
                                <td class="@(debt.Status == "Pending" ? "pending" : "paid")">
                                    @debt.Status
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private decimal previousIncome;
    private decimal previousExpense;
    private decimal previousDebt;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || HasValuesChanged())
        {
            // Update previous values
            previousIncome = TotalIncome;
            previousExpense = TotalExpense;
            previousDebt = TotalDebt;

            // Call JavaScript to render the chart with updated values
            await JSRuntime.InvokeVoidAsync("renderPieChart", TotalIncome, TotalExpense, TotalDebt);
        }
    }

    private bool HasValuesChanged()
    {
        bool changed = previousIncome != TotalIncome || previousExpense != TotalExpense || previousDebt != TotalDebt;
        if (changed)
        {
            Console.WriteLine($"Values changed: Income = {TotalIncome}, Expense = {TotalExpense}, Debt = {TotalDebt}");
        }
        return changed;
    }

    private async Task UpdateChart()
    {
        await JSRuntime.InvokeVoidAsync("renderPieChart", TotalIncome, TotalExpense, TotalDebt);
        StateHasChanged(); // Ensure re-render happens
    }

    protected override void OnParametersSet()
    {
        // Trigger re-render on parameter updates
        StateHasChanged();
    }
}
